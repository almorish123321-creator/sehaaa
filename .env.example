# ============================================
# إعدادات مشروع صحة - Sehaaa Configuration
# ============================================
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك
# NEVER commit .env to GitHub!
#
# عند النشر على Render.com أو أي موقع استضافة:
# أضف هذه المتغيرات من لوحة التحكم (Environment Variables)
# لا حاجة لملف .env على الاستضافة

# === إعدادات البوت (Telegram Bot) ===
BOT_TOKEN=ضع_توكن_البوت_هنا
ADMIN_USER_ID=ضع_رقم_المشرف_هنا

# === إعدادات API الموقع ===
# غيّر الرابط بعد نشر الموقع
API_BASE_URL=http://localhost:5000
API_ENDPOINT=/api/medical-leaves

# === إعدادات Flask ===
FLASK_PORT=5000
FLASK_SECRET_KEY=asdf#FGSgvasgf$5$WGT

# === إعدادات قاعدة البيانات ===
# للإنتاج على Render.com يمكن استخدام PostgreSQL:
# DATABASE_URI=postgresql://user:password@host:port/dbname
DATABASE_URI=sqlite:///src/database/app.db

# === المسارات (لا تحتاج تعديل - تُحسب تلقائياً) ===
# FONTS_DIR=/path/to/fonts
# IMAGES_DIR=/path/to/images
# OUTPUT_DIR=/path/to/output

# === إعدادات PDF ===
PDF_WIDTH=297
PDF_HEIGHT=419
QR_URL=https://www.seha.sa/#/inquiries/slenquiry
